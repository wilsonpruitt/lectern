  "calls": {
    "track": "semicontinuous",
    "registers": [
      {
        "key": "A",
        "label": "Spare",
        "desc": "house voice · 4–8 lines",
        "lines": [
          [
            "The kingdom is a seed too small to notice.",
            "And it grows into a tree for the birds."
          ],
          [
            "It is yeast a woman works through the whole loaf.",
            "Hidden, and changing everything."
          ],
          [
            "It is treasure in a field, a pearl worth all you have.",
            "We have found it, and we will not let go."
          ],
          [
            "Come, let us worship the God of the kingdom.",
            "We come for the hidden treasure. Amen."
          ]
        ]
      },
      {
        "key": "B",
        "label": "Immersive",
        "desc": "sensory anchor · building refrain",
        "lines": [
          [
            "Smell the bread rising — a little yeast worked in by hand, quietly swelling the whole heavy loaf overnight.",
            "The kingdom of God is near."
          ],
          [
            "It starts smaller than you'd believe: a mustard seed in the dirt, a thing you could lose between your fingers.",
            "The kingdom of God is near."
          ],
          [
            "And it becomes a tree, a loaf, a treasure buried in a field that a man sells everything to own.",
            "The kingdom of God is near."
          ],
          [
            "So look closely at the ordinary things of this hour, for the pearl of great price is hidden among them.",
            "The kingdom of God is near. Thanks be to God!"
          ]
        ]
      },
      {
        "key": "C",
        "label": "Hybrid",
        "desc": "economy + one refrain",
        "lines": [
          [
            "A mustard seed, a little yeast in the loaf.",
            "The kingdom of God is near."
          ],
          [
            "Smell the bread rising; small things change everything.",
            "The kingdom of God is near."
          ],
          [
            "Treasure in a field, a pearl worth all we have.",
            "The kingdom of God is near."
          ],
          [
            "Come, let us worship and seek the hidden treasure.",
            "The kingdom of God is near. Amen."
          ]
        ]
      }
    ]
  },
  "turn": null,
