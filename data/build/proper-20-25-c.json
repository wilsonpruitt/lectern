  "calls": {
    "track": "complementary",
    "registers": [
      {
        "key": "A",
        "label": "Spare",
        "desc": "house voice · 4–8 lines",
        "lines": [
          [
            "Praise the Lord, who is high above the nations.",
            "God raises the poor from the dust."
          ],
          [
            "You cannot serve both God and wealth.",
            "God raises the poor from the dust."
          ],
          [
            "He lifts the needy from the ash heap.",
            "Come, let us worship. Amen."
          ]
        ]
      },
      {
        "key": "B",
        "label": "Immersive",
        "desc": "sensory anchor · building refrain",
        "lines": [
          [
            "Hear the prophet's warning to those who trample the needy and skip the measure short.",
            "God raises the poor from the dust."
          ],
          [
            "The Lord is high above the nations, yet stoops to lift the lowly from the ground.",
            "God raises the poor from the dust."
          ],
          [
            "So we cannot split our hearts: no one can serve both God and wealth.",
            "God raises the poor from the dust."
          ],
          [
            "Come, then, with open hands, and worship the God who seats the poor among princes.",
            "God raises the poor from the dust!"
          ]
        ]
      },
      {
        "key": "C",
        "label": "Hybrid",
        "desc": "economy + one refrain",
        "lines": [
          [
            "The Lord, high above the nations, stoops low.",
            "God raises the poor from the dust."
          ],
          [
            "You cannot serve both God and wealth.",
            "God raises the poor from the dust."
          ],
          [
            "Come with open hands to the God of the lowly.",
            "God raises the poor from the dust. Amen."
          ]
        ]
      }
    ]
  },
