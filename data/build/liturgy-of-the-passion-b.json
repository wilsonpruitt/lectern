  "calls": {
    "track": "single",
    "registers": [
      {
        "key": "A",
        "label": "Spare",
        "desc": "house voice · 4–8 lines",
        "lines": [
          [
            "He emptied himself, taking the form of a servant.",
            "He humbled himself to death on a cross."
          ],
          [
            "They struck him, and he did not hide his face.",
            "Into your hands we commend our spirits."
          ],
          [
            "The hosannas fade; the road turns toward the hill.",
            "We follow him to the cross."
          ],
          [
            "At the name of Jesus, every knee shall bow.",
            "Jesus Christ is Lord. Amen."
          ]
        ]
      },
      {
        "key": "B",
        "label": "Immersive",
        "desc": "sensory anchor · building refrain",
        "lines": [
          [
            "The cheering crowds thin out, and the same road that welcomed him now bends toward Golgotha.",
            "Jesus Christ is Lord, to the glory of God."
          ],
          [
            "He who was in the form of God emptied himself, took the towel and the nails, and became obedient to death.",
            "Jesus Christ is Lord, to the glory of God."
          ],
          [
            "They strike him and he does not turn away; he sets his face like flint and gives his back to the smiters.",
            "Jesus Christ is Lord, to the glory of God."
          ],
          [
            "Into your hands, O God, he commends his spirit, and into your hands we commend our own.",
            "Jesus Christ is Lord, to the glory of God."
          ],
          [
            "So we walk the whole hard road with him, that at his name every knee may bow.",
            "Jesus Christ is Lord, to the glory of God. Amen."
          ]
        ]
      },
      {
        "key": "C",
        "label": "Hybrid",
        "desc": "economy + one refrain",
        "lines": [
          [
            "The hosannas fade; the road turns to the hill.",
            "Jesus Christ is Lord."
          ],
          [
            "He empties himself, obedient to the cross.",
            "Jesus Christ is Lord."
          ],
          [
            "Struck and scorned, he does not hide his face.",
            "Jesus Christ is Lord."
          ],
          [
            "Into your hands we commend our spirits.",
            "Jesus Christ is Lord. Amen."
          ]
        ]
      }
    ]
  },
