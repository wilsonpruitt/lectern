  "calls": {
    "track": "single",
    "registers": [
      {
        "key": "A",
        "label": "Spare",
        "desc": "house voice · 4–8 lines",
        "lines": [
          [
            "The Lord is king; let the peoples tremble.",
            "This is my Son; listen to him."
          ],
          [
            "On the mountain his face shone like the sun.",
            "This is my Son; listen to him."
          ],
          [
            "It is good for us to be here.",
            "Come, let us worship. Amen."
          ]
        ]
      },
      {
        "key": "B",
        "label": "Immersive",
        "desc": "sensory anchor · building refrain",
        "lines": [
          [
            "Climb the mountain with them, into thin air and bright cloud, and watch his face begin to shine.",
            "This is my Son, the Chosen; listen to him!"
          ],
          [
            "Moses and Elijah stand with him; the law and the prophets lean toward this one.",
            "This is my Son, the Chosen; listen to him!"
          ],
          [
            "Peter wants to stay, to build, to hold the moment — but glory is not for keeping.",
            "This is my Son, the Chosen; listen to him!"
          ],
          [
            "We come down changed, our own faces catching some of the light, sent back to the valley.",
            "This is my Son, the Chosen; listen to him!"
          ]
        ]
      },
      {
        "key": "C",
        "label": "Hybrid",
        "desc": "economy + one refrain",
        "lines": [
          [
            "On the mountain his face shines like the sun.",
            "This is my Son, the Chosen; listen to him!"
          ],
          [
            "The law and the prophets lean toward this one.",
            "This is my Son, the Chosen; listen to him!"
          ],
          [
            "Glory is not for keeping; we go down changed.",
            "This is my Son; listen to him. Amen."
          ]
        ]
      }
    ]
  },
