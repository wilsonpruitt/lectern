  "calls": {
    "track": "single",
    "registers": [
      {
        "key": "A",
        "label": "Spare",
        "desc": "house voice · 4–8 lines",
        "lines": [
          [
            "While it was still dark, Mary came to the tomb.",
            "The stone was rolled away."
          ],
          [
            "She turned and thought she saw the gardener.",
            "He called her name, and she knew him."
          ],
          [
            "This is the day the Lord has made.",
            "We will rejoice and be glad in it."
          ],
          [
            "Christ is risen!",
            "Christ is risen, alleluia!"
          ]
        ]
      },
      {
        "key": "B",
        "label": "Immersive",
        "desc": "sensory anchor · building refrain",
        "lines": [
          [
            "Come to the garden in the gray of morning, where the grass is wet and the great stone has been rolled back from the door of the grave.",
            "Christ is risen, alleluia!"
          ],
          [
            "Look — the tomb is empty, the linen folded, and death has walked out of the room it claimed.",
            "Christ is risen, alleluia!"
          ],
          [
            "Hear him speak your name the way he spoke Mary's, until your weeping turns to morning.",
            "Christ is risen, alleluia!"
          ],
          [
            "This is the day the Lord has made. Come, you who have wept, and be glad.",
            "Christ is risen, alleluia!"
          ]
        ]
      },
      {
        "key": "C",
        "label": "Hybrid",
        "desc": "economy + one refrain",
        "lines": [
          [
            "At dawn Mary came to the grave and found the stone rolled back.",
            "Christ is risen, alleluia!"
          ],
          [
            "The tomb stood empty; death had let go.",
            "Christ is risen, alleluia!"
          ],
          [
            "He spoke her name, and her grief turned to joy.",
            "Christ is risen, alleluia!"
          ],
          [
            "This is the day the Lord has made. Come, let us worship.",
            "Christ is risen, alleluia!"
          ]
        ]
      }
    ]
  },
  "turn": null,
