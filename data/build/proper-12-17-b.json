          "notes": [
            {
              "chapter": 6,
              "v_start": 1,
              "v_end": 1,
              "text": "After these things — The history of between ten and eleven months is to be supplied here from the other evangelists. Matt. xiv, 13; Mark vi, 32; Luke ix, 10."
            },
            {
              "chapter": 6,
              "v_start": 3,
              "v_end": 3,
              "text": "Jesus went up — Before the people overtook him."
            },
            {
              "chapter": 6,
              "v_start": 5,
              "v_end": 5,
              "text": "Jesus saith to Philip — Perhaps he had the care of providing victuals for the family of the apostles."
            },
            {
              "chapter": 6,
              "v_start": 15,
              "v_end": 15,
              "text": "He retired to the mountain alone — Having ordered his disciples to cross over the lake."
            },
            {
              "chapter": 6,
              "v_start": 16,
              "v_end": 16,
              "text": "Matt. xiv, 22; Mark vi, 45."
            }
          ]
        }
