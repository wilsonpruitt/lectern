  "calls": {
    "track": "complementary",
    "registers": [
      {
        "key": "A",
        "label": "Spare",
        "desc": "house voice · 4–8 lines",
        "lines": [
          [
            "Happy are those whose transgression is forgiven.",
            "Today salvation has come to this house."
          ],
          [
            "Zacchaeus, hurry down; I must stay at your house today.",
            "Today salvation has come to this house."
          ],
          [
            "Wash, make clean; learn to do good, seek justice.",
            "Come, let us worship. Amen."
          ]
        ]
      },
      {
        "key": "B",
        "label": "Immersive",
        "desc": "sensory anchor · building refrain",
        "lines": [
          [
            "A small, despised man climbs a tree just to see, and Jesus stops and calls him by name.",
            "Today salvation has come to this house."
          ],
          [
            "Come down, I must stay with you — and grace walks straight into a house everyone avoided.",
            "Today salvation has come to this house."
          ],
          [
            "The change is real: half to the poor, fourfold to the cheated, a life turned right-side up.",
            "Today salvation has come to this house."
          ],
          [
            "For the Son of Man came to seek and to save the lost — which is to say, came for us.",
            "Today salvation has come to this house!"
          ]
        ]
      },
      {
        "key": "C",
        "label": "Hybrid",
        "desc": "economy + one refrain",
        "lines": [
          [
            "A despised man climbs a tree; Jesus calls his name.",
            "Today salvation has come to this house."
          ],
          [
            "Grace walks into the house everyone avoided.",
            "Today salvation has come to this house."
          ],
          [
            "The Son of Man came to seek and save the lost.",
            "Today salvation has come to this house. Amen."
          ]
        ]
      }
    ]
  },
