          "notes": [
            {
              "chapter": 66,
              "v_start": 1,
              "v_end": 1,
              "text": "All lands — Ye people of all nations. He invites the Gentile world, to the contemplation and celebration of God's works."
            },
            {
              "chapter": 66,
              "v_start": 6,
              "v_end": 6,
