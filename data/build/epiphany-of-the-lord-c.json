    "registers": [
      {
        "key": "A",
        "label": "Spare",
        "desc": "house voice · 4–8 lines",
        "lines": [
          [
            "Arise, shine, for your light has come.",
            "The glory of the Lord has risen upon us."
          ],
          [
            "Nations shall come to your light, and kings to the brightness of your dawn.",
            "The glory of the Lord has risen upon us."
          ],
          [
            "We have seen his star and have come to worship.",
            "Come, let us adore him. Amen."
          ]
        ]
      },
      {
        "key": "B",
        "label": "Immersive",
        "desc": "sensory anchor · building refrain",
        "lines": [
          [
            "It is still dark, but there is a light on the horizon, and travelers are following it.",
            "Arise, shine; your light has come!"
          ],
          [
            "From far countries they come, bearing what is precious, drawn by a single star.",
            "Arise, shine; your light has come!"
          ],
          [
            "The light is not for one people only; the whole world is invited to the brightness.",
            "Arise, shine; your light has come!"
          ],
          [
            "So lift up your eyes and look around — and come, with the magi, and kneel.",
            "Arise, shine; the glory of the Lord has risen upon you!"
          ]
        ]
      },
      {
        "key": "C",
        "label": "Hybrid",
        "desc": "economy + one refrain",
        "lines": [
          [
            "A light on the horizon, and travelers following.",
            "Arise, shine; your light has come!"
          ],
          [
            "From far countries they come, drawn by a star.",
            "Arise, shine; your light has come!"
          ],
          [
            "The light is for the whole world; come and kneel.",
            "Arise, shine; your light has come! Amen."
          ]
        ]
      }
    ]
