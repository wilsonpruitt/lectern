  "calls": {
    "track": "complementary",
    "registers": [
      {
        "key": "A",
        "label": "Spare",
        "desc": "house voice · 4–8 lines",
        "lines": [
          [
            "God is our refuge and strength, a very present help.",
            "Jesus, remember us in your kingdom."
          ],
          [
            "In him all things hold together; he is the firstborn from the dead.",
            "Jesus, remember us in your kingdom."
          ],
          [
            "Be still, and know that I am God.",
            "Come, let us worship the King. Amen."
          ]
        ]
      },
      {
        "key": "B",
        "label": "Immersive",
        "desc": "sensory anchor · building refrain",
        "lines": [
          [
            "Here is a strange throne: a cross, two criminals, a mocking sign that reads The King.",
            "Jesus, remember me when you come into your kingdom."
          ],
          [
            "And from that throne, to a dying thief, the King speaks pardon: today, with me, in paradise.",
            "Jesus, remember me when you come into your kingdom."
          ],
          [
            "This is the one in whom all things were made and in whom all things hold together.",
            "Jesus, remember me when you come into your kingdom."
          ],
          [
            "So we crown him — not with our power but with our need — the crucified and reigning Lord.",
            "Jesus, remember us when you come into your kingdom!"
          ]
        ]
      },
      {
        "key": "C",
        "label": "Hybrid",
        "desc": "economy + one refrain",
        "lines": [
          [
            "A strange throne: a cross, a sign that reads The King.",
            "Jesus, remember us in your kingdom."
          ],
          [
            "To a dying thief the King speaks pardon: today, paradise.",
            "Jesus, remember us in your kingdom."
          ],
          [
            "In him all things hold together; we crown him with our need.",
            "Jesus, remember us in your kingdom. Amen."
          ]
        ]
      }
    ]
  },
  "turn": null,
