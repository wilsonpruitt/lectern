    "registers": [
      {
        "key": "A",
        "label": "Spare",
        "desc": "house voice · 4–8 lines",
        "lines": [
          [
            "Look up — the stars are past counting, and so is the promise.",
            "We are pilgrims on the way to the cross."
          ],
          [
            "The Lord is our light; whom shall we fear?",
            "We wait for the Lord; we take heart."
          ],
          [
            "Like a hen over her brood, God longs to gather us.",
            "Gather us, Lord, and lead us home."
          ]
        ]
      },
      {
        "key": "B",
        "label": "Immersive",
        "desc": "sensory anchor · building refrain",
        "lines": [
          [
            "How often the mother bird spreads her wings over the brood, calling the scattered chicks back beneath her warmth.",
            "We are pilgrims on the way to the cross."
          ],
          [
            "Count the stars, if you can — God's promise outruns the night sky, older than your fear, surer than the dark.",
            "We are pilgrims on the way to the cross."
          ],
          [
            "The Lord is our light and our salvation; though the foxes prowl, we will not be afraid.",
            "We are pilgrims on the way to the cross."
          ],
          [
            "So come under the shadow of those wings, and set your face with him toward the city.",
            "We are pilgrims on the way to the cross. Amen."
          ]
        ]
      },
      {
        "key": "C",
        "label": "Hybrid",
        "desc": "economy + one refrain",
        "lines": [
          [
            "God longs to gather us as a hen gathers her chicks beneath her wings.",
            "Turn us, O God, and we will return."
          ],
          [
            "The Lord is our light; whom shall we fear?",
            "Turn us, O God, and we will return."
          ],
          [
            "We set our faces with Christ toward the city.",
            "Turn us, O God, and we will return. Amen."
          ]
        ]
      }
