  "calls": {
    "track": "single",
    "registers": [
      {
        "key": "A",
        "label": "Spare",
        "desc": "house voice · 4–8 lines",
        "lines": [
          [
            "The voice of the Lord is over the waters.",
            "The God of glory thunders."
          ],
          [
            "Jesus comes to the river and goes down into the water.",
            "The heavens open over him."
          ],
          [
            "The Spirit descends like a dove, and a voice speaks.",
            "This is my beloved."
          ],
          [
            "Come, let us worship at the water's edge.",
            "You are my beloved. Amen."
          ]
        ]
      },
      {
        "key": "B",
        "label": "Immersive",
        "desc": "sensory anchor · building refrain",
        "lines": [
          [
            "Stand with him at the river's edge, the cold water moving over the stones, and watch him wade out and go under.",
            "You are my beloved."
          ],
          [
            "The sky tears open above the water, and the Spirit comes down soft as a dove, and a voice rolls across the river.",
            "You are my beloved."
          ],
          [
            "This is the same voice the prophet heard — calling a servant by name, gentle enough not to break a bruised reed.",
            "You are my beloved."
          ],
          [
            "And the voice is not only for him; it is spoken over every one of you the waters have claimed.",
            "You are my beloved. Thanks be to God!"
          ]
        ]
      },
      {
        "key": "C",
        "label": "Hybrid",
        "desc": "economy + one refrain",
        "lines": [
          [
            "The voice of the Lord thunders over the waters.",
            "You are my beloved."
          ],
          [
            "Jesus goes down into the river, and the sky opens.",
            "You are my beloved."
          ],
          [
            "The Spirit comes like a dove; the voice speaks.",
            "You are my beloved."
          ],
          [
            "Come, let us worship at the water.",
            "You are my beloved. Thanks be to God!"
          ]
        ]
      }
    ]
  },
